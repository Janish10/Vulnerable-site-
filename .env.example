# ─── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_USER=soltrisk
POSTGRES_PASSWORD=soltrisk_bench_2024
POSTGRES_DB=soltrisk

# ─── Backend ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
JWT_SECRET=soltrisk-secret-key-2024
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
CORS_ORIGIN=http://app.krizznaa.tech,https://app.krizznaa.tech

# ─── Frontend ────────────────────────────────────────────────────
VITE_API_URL=https://api.krizznaa.tech

# ─── Grafana (real instance) ─────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=true
GF_SERVER_ROOT_URL=http://grafana.krizznaa.tech

# ─── Jenkins (real instance) ─────────────────────────────────────
JENKINS_OPTS=--prefix=/
JAVA_OPTS=-Djenkins.install.runSetupWizard=false
